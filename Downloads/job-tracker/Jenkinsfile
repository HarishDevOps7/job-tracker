
pipeline {
    agent any

    tools {
        jdk 'JDK21'
        maven 'Maven-3.9.11'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Build') {
            steps {
                dir('Downloads/job-tracker') {
                    echo 'Building Job Tracker application'
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Unit Testing') {
            steps {
                dir('Downloads/job-tracker') {
                    echo 'Running JUnit and Mockito tests'
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('Downloads/job-tracker') {
                    echo 'Creating executable JAR'
                    sh 'mvn package -DskipTests'
                }
            }
        }
    }


     stage('SonarCloud Analysis') {
            steps {
                dir('Downloads/job-tracker') {
                    withSonarQubeEnv('SonarCloud') {
                        sh '''
                            sonar-scanner \
                            -Dsonar.token="$SONAR_AUTH_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'Downloads/job-tracker/target/surefire-reports/*.xml',
                  allowEmptyResults: true

            archiveArtifacts artifacts: 'Downloads/job-tracker/target/*.jar',
                             allowEmptyArchive: true
        }

        success {
            echo 'JOB TRACKER CI PIPELINE SUCCESS'
        }

        failure {
            echo 'JOB TRACKER CI PIPELINE FAILED'
        }
    }
}
